  "direction_groups": [
    {
      "title": "Make the Brownies",
      "steps": [
        "Preheat your oven to 350 degrees Fahrenheit.",
        "Line an 8- x 8-inch pan with Gefen Parchment Paper, and spray with cooking spray. In a food processor, process the apple, dates, banana, maple syrup, and vanilla until almost smooth.",
        "In a medium bowl, combine the flour, almonds, cocoa, baking powder, baking soda, and salt. Add this mixture to the processor and pulse until the wet and dry ingredients are fully combined. Pour into the prepared pan.",
        "Bake for 25 minutes. Cut into nine squares when cooled."
      ]
