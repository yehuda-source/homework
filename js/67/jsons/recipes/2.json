  "direction_groups": [
    {
      "title": "Make the Kugel",
      "steps": [
        "Preheat oven to 350 degrees Fahrenheit. Spray a 10-inch round oven-to-table baking dish with nonstick spray.",
        "Peel squash and cut in cubes, discarding seeds. Peel sweet potatoes and cut in cubes. Cook in boiling salted water until soft, about 15 to 20 minutes. Drain thoroughly.",
        "Place all ingredients for filling of kugel into a large bowl and mix vigorously until completely smooth, or use an immersion blender. Pour filling into baking dish.",
        "Place all topping ingredients except toasted pecans in a large bowl and crumble with the tips of your fingers until fine crumbs form. Spread crumbs out on a baking sheet lined with parchment paper and bake for 10 minutes.",
        "Remove toasted crumbs from oven, let cool for a few minutes, then sprinkle on top of prepared kugel filling.",
        "Sprinkle toasted pecans evenly over the top of the kugel and bake for 35 minutes, on a lower rack in the oven (so the top doesn't burn). Serve warm."
      ]
    }
  ],
  "tips": "Notes:\nSubstitute 2 bags (14 ounces each) frozen butternut squash cubes and 1 (14-ounce) bag frozen sweet potato cubes. Defrost and pat dry with paper towels. Continue as directed in Step 3.",
