  "direction_groups": [
    {
      "title": "Prepare the London Broil",
      "steps": [
        "Preheat oven to 400F.",
        "Slice the onions and pepper into strips. Spread it out onto a 9 by 13 pan. Put the London broil on top of the veggies. Drizzle some honey and olive oil on top and then pour wine in. Add the salt, garlic powder, onion powder, black pepper and then top it off with some paprika.",
        "Bake covered for an hour and 15 minutes. Then uncover for another 15 minutes.",
        "Your meat is now ready but for the best effect and to get it really soft you can cover it on 225F for 45 to 90 minutes. Great tip for Friday night: cover your ready meat and place it in the oven on Shabbos mode on 225 until you are ready to serve."
      ]
    }
