  "direction_groups": [
    {
      "title": "Prepare the Deli Roses",
      "steps": [
        "Preheat oven to 375 degrees Fahrenheit.",
        "Lightly grease two twelve-cup muffin pans with oil.",
        "On a lightly-floured work surface, roll out one piece of puff pastry to a 14 inch x20 inch rectangle. Position the dough horizontally, facing you. Using the Betty Bossi Rose Roller, cut the dough into six scalloped strips.",
        "Brush honey mustard on the dough. Top with sliced pastrami. Brush with some more honey mustard.",
        "Roll up the pastry and slice in half through the center of the roll so you have two roses.",
        "Place “rose” in the muffin pan, scalloped side up. Repeat with remaining sheet of puff pastry.",
        "Bake for 20 minutes or until dough is puffed and golden brown."
      ]
    }
